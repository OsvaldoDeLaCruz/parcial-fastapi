# Copiar este archivo como .env y completar los valores reales (.env NO se sube a GitHub)

# Base de datos
DATABASE_URL=sqlite:///./app.db

# JWT
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP (maximo 15 minutos)
OTP_EXPIRE_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP - opcion 1: Gmail con contrasena de aplicacion (desarrollo local)
# SMTP - opcion 2: Brevo (produccion en Render):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525
#   SMTP_USER=<login SMTP de Brevo>  SMTP_PASSWORD=<clave SMTP de Brevo>
#   SMTP_FROM=<remitente verificado en Brevo>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# Solo desarrollo local: true = no envia correo, muestra el OTP en la consola.
# En produccion debe ser false.
EMAIL_CONSOLE_MODE=false
